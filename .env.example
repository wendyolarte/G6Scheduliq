PORT=3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=smart_scheduler

# Use a long random string in real deployments
JWT_SECRET=replace_with_a_long_random_secret

# The admin account is created automatically on first start.
# Only this account (and admins it creates) can open Admin Mode.
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@school.edu
ADMIN_PASSWORD=replace_with_a_unique_admin_password
