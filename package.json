{
  "name": "Scheduliq",
  "version": "1.0.0",
  "description": "Class scheduling project for organizing courses, rooms, schedule options, and approvals",
  "keywords": [
    "class-scheduling",
    "timetable",
    "course-scheduling",
    "classroom-management",
    "education",
    "express",
    "mysql"
  ],
  "homepage": "https://github.com/wendyolarte/G6Scheduliq#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wendyolarte/G6Scheduliq.git"
  },
  "bugs": {
    "url": "https://github.com/wendyolarte/G6Scheduliq/issues"
  },
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "db:init": "node server/scripts/init-db.js",
    "seed": "node server/scripts/seed.js",
    "setup": "npm run db:init && npm run seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.7"
  },
  "engines": {
    "node": ">=18"
  }
}